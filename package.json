{
  "name": "course-platform",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "create-admin": "node scripts/create-admin.mjs",
    "backup:storage": "node scripts/backup-storage.mjs",
    "test:e2e": "node scripts/e2e.mjs",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "test:e2e:workers": "node scripts/e2e.mjs --workers",
    "deploy:win": "node scripts/deploy-cloudflare.mjs"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.8",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "next": "^15.5.27",
    "nodemailer": "^10.0.10",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10",
    "eslint": "^8",
    "eslint-config-next": "^15.5.27",
    "playwright-core": "^1.63.0",
    "postcss": "^8",
    "sharp": "^0.35.4",
    "tailwindcss": "^3",
    "typescript": "^5",
    "wrangler": "^4.147.0"
  }
}
